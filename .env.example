# Copy to .env (next to manage.py) and adjust. .env is git-ignored.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Nairobi

# Frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave empty for local dev (in-memory chat layer). Set in production.
REDIS_URL=
# REDIS_URL=redis://127.0.0.1:6379/0

# Set these to use PostgreSQL instead of SQLite
# POSTGRES_DB=friends_portal
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Rate limits
# THROTTLE_ANON=100/hour
# THROTTLE_USER=1000/hour
# THROTTLE_LOGIN=20/hour

# ---------------------------------------------------------------- Email
# Leave EMAIL_HOST empty in development: emails are printed in the runserver terminal.
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, your address + an App Password
#   (Google Account → Security → 2-Step Verification → App passwords).
# Brevo / Mailgun / SendGrid / Zoho / cPanel: use the SMTP details they give you.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Friends Church <no-reply@your-domain.org>
# Web address of the frontend, used for links inside emails
FRONTEND_URL=http://localhost:5173
PLATFORM_NAME=Friends Church (Quakers)

# ---------------------------------------------------------------- Google sign-in
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# (Web application). Add http://localhost:5173 and your live site under
# "Authorized JavaScript origins". Paste the Client ID here; leave empty to hide the button.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------- Secrets at rest
# Encrypts each church's YouTube stream key in the database. Set once and keep it:
# if it changes, Clerks will need to re-enter their stream keys.
FIELD_ENCRYPTION_KEY=

# ---------------------------------------------------------------- Live studio (browser → YouTube)
# Path to ffmpeg if it isn't on the PATH, e.g. C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=
# Testing only: write the stream to a file instead of YouTube, e.g. /tmp/test-{key}.flv
STREAM_OUTPUT_URL=

# ---------------------------------------------------------------- Church subdomains (multi-tenancy)
# Each church is served at <slug>.<base domain>, e.g. kaimosi.friends.example.org. Needs wildcard DNS and a
# wildcard TLS certificate for *.<base domain>, and the web server must pass the Host header through.
# Leave empty in development: churches stay at /c/<slug>.
TENANT_BASE_DOMAIN=
TENANT_URL_SCHEME=https
